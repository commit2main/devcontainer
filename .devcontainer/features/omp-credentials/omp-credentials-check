#!/bin/sh
# Diagnose the shared agent directory without reading credentials or changing
# host state. Every diagnostic is nonfatal so container startup can continue.
mount=/mnt/omp-agent
volume=omp-credentials

warn() { echo "omp-credentials: $*" >&2; }

mapping_help() {
    warn "The container user must map to the host user that owns the state:"
    warn "keep updateRemoteUserUID enabled (Docker) or use --userns=keep-id (rootless Podman)."
    warn "Check host access permissions; this checker does not change ownership or modes."
}

if [ "${PI_CODING_AGENT_DIR:-}" != "$mount" ]; then
    warn "PI_CODING_AGENT_DIR is not $mount; omp will not use this shared agent directory."
fi

root="$(awk -v m="$mount" '$5 == m { r = $4 } END { print r }' /proc/self/mountinfo 2>/dev/null)"
case "$root" in
    "")
        warn "$mount is not mounted; rebuild the container with the omp-credentials feature."
        exit 0
        ;;
    */volumes/*/_data)
        warn "volume '$volume' is an ordinary named volume, not bound to a host directory; host state is not shared."
        warn "On the host, inspect it with 'docker volume inspect $volume' or 'podman volume inspect $volume'."
        warn "Check the intended source is the SAME active ordinary agent directory host omp uses."
        warn "Detach existing consumers, then manually recreate the volume as a host bind only after checking that source."
        warn "Do not delete existing state; see the host setup instructions before recreating the volume."
        ;;
esac

if ! { [ -r "$mount" ] && [ -w "$mount" ] && [ -x "$mount" ]; }; then
    warn "container uid $(id -u) cannot read, write and search $mount."
    mapping_help
    exit 0
fi

db="$mount/agent.db"
if [ -e "$db" ] || [ -L "$db" ]; then
    if ! { [ -r "$db" ] && [ -w "$db" ]; }; then
        warn "container uid $(id -u) cannot read and write $db; the shared credential database is inaccessible."
        mapping_help
    fi
else
    warn "no agent.db found yet; for first use, run omp and /login here or on the host using this same agent directory."
fi
exit 0
