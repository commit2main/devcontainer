#!/bin/sh
# Reports why the shared Claude config volume is unusable. Never fails, so a
# misconfigured host cannot block the container from starting, and never
# changes ownership or modes: the files belong to the host.
mount=/mnt/claude-credentials
volume=claude-credentials

warn() { echo "claude-credentials: $*" >&2; }

if [ "${CLAUDE_CONFIG_DIR:-}" != "$mount" ]; then
    warn "CLAUDE_CONFIG_DIR is '${CLAUDE_CONFIG_DIR:-}', not $mount; the shared credentials are not in use."
fi

root="$(awk -v m="$mount" '$5 == m { r = $4 } END { print r }' /proc/self/mountinfo)"
case "$root" in
    "")
        warn "$mount is not mounted; rebuild the container."
        exit 0
        ;;
    */volumes/*/_data)
        warn "volume '$volume' is not bound to a host directory, so nothing is shared with the host."
        warn "On the host, remove it and recreate it bound to your Claude config directory:"
        warn "  docker volume rm $volume"
        warn "  docker volume create --driver local --opt type=none --opt o=bind \\"
        warn "    --opt device=\"\$(realpath \"\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}\")\" $volume"
        ;;
esac

creds="$mount/.credentials.json"
if ! { [ -r "$mount" ] && [ -w "$mount" ] && [ -x "$mount" ]; } ||
   { [ -e "$creds" ] && ! { [ -r "$creds" ] && [ -w "$creds" ]; }; }; then
    warn "$(id -un) (uid $(id -u)) cannot read and write $mount (owned by uid $(stat -c %u "$mount"))."
    warn "The container user must map to the host user that owns the directory:"
    warn "keep updateRemoteUserUID enabled (Docker) or run with --userns=keep-id (rootless Podman)."
elif [ ! -e "$creds" ]; then
    warn "no credentials found yet; run 'claude' and log in once, here or on the host."
fi
exit 0
