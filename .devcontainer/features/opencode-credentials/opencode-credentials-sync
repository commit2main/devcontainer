#!/usr/bin/env bash
# Merges this machine's OpenCode credentials with a shared store file.
#
# Every machine (the host and each container) keeps its own opencode.db; only
# the JSON produced by `opencode auth export` is exchanged, under a file lock.
# The script never opens the database itself, never changes ownership or modes
# of the store, and never puts a secret on a command line or in a log.
#
#   opencode-credentials-sync            sync once
#   opencode-credentials-sync --watch    sync whenever either side changes
#   opencode-credentials-sync --start    sync once, then watch in the background
set -uo pipefail
umask 077

store="${OPENCODE_CREDENTIALS_DIR:-/mnt/opencode-credentials}"
file="$store/credentials.json"
interval="${OPENCODE_CREDENTIALS_INTERVAL:-30}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/opencode-credentials"
db="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"

log() { echo "opencode-credentials: $*" >&2; }

# jq over a value held in memory, without a here-string's temporary file.
j() { printf '%s' "$1" | jq "${@:2}"; }

# Explains an unusable store; returns non-zero when syncing is pointless.
check() {
    if ! command -v opencode >/dev/null 2>&1; then
        log "opencode is not installed; nothing to sync."
        return 1
    fi
    local root
    root="$(awk -v m="$store" '$5 == m { r = $4 } END { print r }' /proc/self/mountinfo)"
    if [[ "$root" == */volumes/*/_data ]]; then
        log "the volume at $store is not bound to a host directory, so nothing is shared with the host."
        log "Run host-setup.sh from the feature on the host, then rebuild the container."
    fi
    if ! { [[ -d "$store" && -r "$store" && -w "$store" && -x "$store" ]]; } ||
       { [[ -e "$file" ]] && ! { [[ -r "$file" && -w "$file" ]]; }; }; then
        log "$(id -un) (uid $(id -u)) cannot read and write $store."
        log "The container user must map to the host user that owns it: keep"
        log "updateRemoteUserUID enabled (Docker) or use --userns=keep-id (rootless Podman)."
        return 1
    fi
}

# Decides what to do from [local, store, known ids] on stdin.
#
# An OAuth credential is replaced by the copy that expires later, which is the
# one refreshed most recently. A credential that was synced before and is now
# missing on one side was logged out there, so it is removed from the other,
# except when either side is empty: an empty side is treated as new, never as
# "everything was logged out".
plan='
  .[0] as $local | .[1] as $store
  | ($local | INDEX(.id)) as $l | ($store | INDEX(.id)) as $s
  | (.[2] | map({key: ., value: true}) | from_entries) as $known
  | (($local | length) > 0 and ($store | length) > 0) as $prune
  | def gone: $prune and $known[.id] == true;
    def fresher($a; $b):
      $a.value.type == "oauth" and $b.value.type == "oauth"
      and ($a.value.expires // 0) > ($b.value.expires // 0);
    {
      drop: [$local[] | select($s[.id] == null and gone) | {id, integrationID}],
      pull: [$store[]
             | $l[.id] as $mine
             | if $mine == null then select(gone | not)
               else select($mine.value != .value and (fresher($mine; .) | not))
                    | .active = $mine.active
               end],
      store: ([$store[]
               | $l[.id] as $mine
               | if $mine == null then select(gone | not)
                 elif fresher($mine; .) then $mine
                 else . end]
              + [$local[] | select($s[.id] == null and (gone | not))])
    }
  | .replace = [.pull[] | select($l[.id] != null) | {id, integrationID, active}]
  | .changed = ((.store | map(del(.active))) != ($store | map(del(.active))))
'

sync() (
    cd /
    flock -w 60 9 || { log "the store is locked by another sync."; exit 1; }

    # Go through the background service when it runs, so it sees the change;
    # otherwise use a private server that exits again.
    mode=()
    [[ "$(opencode service status 2>/dev/null)" == stopped ]] && mode=(--standalone)

    local_json="$(opencode auth export "${mode[@]}" 2>/dev/null)" &&
        j "$local_json" -e 'type == "array"' >/dev/null 2>&1 ||
        { log "could not export the local credentials."; exit 1; }

    store_json='[]' known='[]'
    if [[ -s "$file" ]]; then
        store_json="$(cat "$file")"
        j "$store_json" -e 'type == "array"' >/dev/null 2>&1 ||
            { log "$file is not valid; fix or delete it."; exit 1; }
        [[ -s "$state/synced.json" ]] && known="$(cat "$state/synced.json")"
    fi

    todo="$(printf '%s\n%s\n%s\n' "$local_json" "$store_json" "$known" | jq -s "$plan")" ||
        { log "could not merge the credentials."; exit 1; }

    if [[ "$(j "$todo" '.changed')" == true ]]; then
        j "$todo" '.store' >"$file.tmp.$$" && mv -f "$file.tmp.$$" "$file" ||
            { rm -f "$file.tmp.$$"; log "could not write $file."; exit 1; }
    fi

    # Until the imports below succeed, do not record them as synced: a failed
    # import must be retried, not mistaken for a logout.
    mkdir -p "$state"
    j "$todo" '[.store[].id] - [.pull[].id]' >"$state/synced.json"

    while read -r integration id; do
        opencode auth logout "${mode[@]}" "$integration" "$id" </dev/null >/dev/null 2>&1 ||
            log "could not remove credential $id."
    done < <(j "$todo" -r '(.drop + .replace)[] | "\(.integrationID) \(.id)"')

    if [[ "$(j "$todo" '.pull | length')" != 0 ]]; then
        j "$todo" '.pull' | opencode auth import "${mode[@]}" >/dev/null 2>&1 ||
            { log "could not import the shared credentials."; exit 1; }
        while read -r id; do
            opencode api "${mode[@]}" POST "/api/credential/$id/activate" >/dev/null 2>&1
        done < <(j "$todo" -r '.replace[] | select(.active) | .id')
    fi
    j "$todo" '[.store[].id]' >"$state/synced.json"

    counts="$(j "$todo" -r '"\(.pull | length) \(.drop | length) \(.changed)"')"
    [[ "$counts" == "0 0 false" ]] ||
        log "imported ${counts%% *}, removed $(cut -d' ' -f2 <<<"$counts"), store updated: ${counts##* }."
) 9>"$store/.lock"

signature() { stat -c '%n %Y %s' "$file" "$db" "$db-wal" 2>/dev/null; }

watch() {
    mkdir -p "$state"
    exec 8>"$state/watch.lock"
    flock -n 8 || exit 0
    local last="" pass=0
    while :; do
        # Sync when either side changed, and every 20th pass regardless.
        if [[ "$(signature)" != "$last" ]] || ((pass % 20 == 0)); then
            sync
            last="$(signature)"
        fi
        pass=$((pass + 1))
        sleep "$interval"
    done
}

case "${1:-}" in
    "") check && sync ;;
    --watch) check && watch ;;
    --start)
        # Runs as postStartCommand: must not fail or block the container.
        if check; then
            sync
            mkdir -p "$state"
            setsid nohup "$0" --watch </dev/null >>"$state/watch.log" 2>&1 &
        fi
        exit 0
        ;;
    *) echo "usage: ${0##*/} [--watch|--start]" >&2; exit 2 ;;
esac
